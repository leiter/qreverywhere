# Fastfile for QrEveryWhere iOS
# Documentation: https://docs.fastlane.tools

default_platform(:ios)

# App Store Connect API Key authentication
def api_key
  app_store_connect_api_key(
    key_id: "M4S9AWXXL7",
    issuer_id: "e3c717d8-00fc-4ff7-8a05-65f96d2b1562",
    # Key lives outside the repo so it is never committed. Falls back to the
    # fastlane dir for CI, where the key is materialised next to the Fastfile.
    key_filepath: [
      File.expand_path("~/.appstoreconnect/private_keys/AuthKey_M4S9AWXXL7.p8"),
      File.expand_path("AuthKey_M4S9AWXXL7.p8", __dir__)
    ].find { |path| File.exist?(path) },
    in_house: false
  )
end

# Version numbers live in the build settings, and Info.plist derives them via
# $(MARKETING_VERSION) / $(CURRENT_PROJECT_VERSION).
#
# These edit the pbxproj directly instead of using increment_build_number and
# increment_version_number. Those drive agvtool, which rewrites the Info.plist
# keys back into literals ("Also setting CFBundleVersion key") and so recreates
# the two-sources-of-truth problem on every bump.
XCODEPROJ = "iosApp.xcodeproj"
PBXPROJ = "iosApp.xcodeproj/project.pbxproj"

def each_build_setting(key)
  require 'xcodeproj'
  project = Xcodeproj::Project.open(File.expand_path(XCODEPROJ, __dir__ + "/.."))
  value = nil
  project.targets.each do |target|
    target.build_configurations.each do |config|
      value = yield(config.build_settings[key])
      config.build_settings[key] = value
    end
  end
  project.save
  value
end

def bump_build_number
  each_build_setting("CURRENT_PROJECT_VERSION") { |current| (current.to_i + 1).to_s }
end

def bump_marketing_version(type)
  each_build_setting("MARKETING_VERSION") do |current|
    major, minor, patch = current.to_s.split(".").map(&:to_i)
    minor ||= 0
    patch ||= 0
    case type
    when "major" then "#{major + 1}.0.0"
    when "minor" then "#{major}.#{minor + 1}.0"
    when "patch" then "#{major}.#{minor}.#{patch + 1}"
    else UI.user_error!("bump_version type must be major, minor or patch (got #{type.inspect})")
    end
  end
end

def current_build_setting(key)
  require 'xcodeproj'
  project = Xcodeproj::Project.open(File.expand_path(XCODEPROJ, __dir__ + "/.."))
  project.targets.each do |target|
    target.build_configurations.each do |config|
      value = config.build_settings[key]
      return value if value
    end
  end
  nil
end

# Records what was actually shipped: commits the build-number bump the lane made
# at its start, then tags it.
#
# Called only AFTER a successful upload, deliberately. bump_build_number runs
# first in the lane, so a run that dies in build_app or upload burns a build
# number without shipping anything (1.0.1 went through builds 12 and 13 that way).
# Tagging at bump time would leave tags pointing at builds that never existed.
#
# Tags are platform-prefixed because iOS and Android version independently -
# androidApp/build.gradle.kts carries its own versionName/versionCode.
def tag_release(channel, push: true)
  version = current_build_setting("MARKETING_VERSION")
  build = current_build_setting("CURRENT_PROJECT_VERSION")
  tag = "ios/#{version}+#{build}"

  git_commit(path: [PBXPROJ], message: "iOS #{channel} #{version} (build #{build})")
  add_git_tag(tag: tag)
  push_to_git_remote(tags: true) if push

  UI.success("Tagged #{tag}#{push ? ' and pushed' : ' (local only)'}")
  tag
end

platform :ios do
  desc "Run tests"
  lane :test do
    run_tests(
      scheme: "iosApp",
      device: "iPhone 15 Pro"
    )
  end

  desc "Build iOS app for simulator"
  lane :build_simulator do
    # Increment build number
    bump_build_number

    build_app(
      scheme: "iosApp",
      configuration: "Debug",
      destination: "generic/platform=iOS Simulator",
      skip_archive: true
    )
  end

  desc "Build iOS app for device (requires signing)"
  lane :build do
    # Increment build number
    bump_build_number

    # Download provisioning profile
    sigh(
      app_identifier: "cut.the.crap.qreverywhere",
      api_key: api_key,
      readonly: true
    )

    build_app(
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store"
    )
  end

  desc "Submit a new Beta Build to TestFlight"
  lane :beta do |options|
    # A tag is only meaningful if the build came from committed source. Without
    # this, a lane can archive a dirty working tree and then tag a commit that
    # does not contain what shipped.
    ensure_git_status_clean

    # Increment build number
    bump_build_number

    # Download provisioning profile
    sigh(
      app_identifier: "cut.the.crap.qreverywhere",
      api_key: api_key,
      readonly: true
    )

    # Build the app
    build_app(
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store"
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )

    # skip_waiting_for_build_processing means this returns before Apple finishes
    # processing, so the tag marks what was submitted, not what went live.
    tag_release("beta", push: options.fetch(:push, true))
  end

  desc "Deploy a new version to the App Store"
  lane :deploy do |options|
    # A tag is only meaningful if the build came from committed source. Without
    # this, a lane can archive a dirty working tree and then tag a commit that
    # does not contain what shipped.
    ensure_git_status_clean

    # Increment build number
    bump_build_number

    # Download provisioning profile
    sigh(
      app_identifier: "cut.the.crap.qreverywhere",
      api_key: api_key,
      readonly: true
    )

    # Build the app
    build_app(
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store"
    )

    # Upload to App Store
    upload_to_app_store(
      api_key: api_key,
      force: true,
      submit_for_review: false,
      automatic_release: false
    )

    tag_release("release", push: options.fetch(:push, true))
  end

  desc "Upload metadata and screenshots only (no binary)"
  desc "Pass skip_screenshots:true to upload text metadata without touching screenshots"
  lane :deliver_metadata do |options|
    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: options[:skip_screenshots] || false,
      force: true,
      submit_for_review: false,
      automatic_release: false
    )
  end

  desc "Increment build number"
  lane :bump_build do
    bump_build_number
  end

  desc "Increment the marketing version (major|minor|patch, default patch)"
  lane :bump_version do |options|
    version = bump_marketing_version(options[:type] || "patch")
    UI.success("Marketing version is now #{version}")
  end

  desc "Submit the current App Store version for review (uploads nothing)"
  desc "Declarations mirror iosApp/appstore/app_store_connect_answers.md"
  lane :submit_review do
    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false,
        content_rights_contains_third_party_content: false
      }
    )
  end

  desc "Print the latest build number available on TestFlight"
  lane :latest_beta do
    build = latest_testflight_build_number(
      app_identifier: "cut.the.crap.qreverywhere",
      api_key: api_key
    )
    UI.important("Latest TestFlight build: #{build}")
  end

  desc "Sync certificates and provisioning profiles"
  lane :sync_certificates do
    match(
      type: "appstore",
      readonly: true
    )
  end
end
